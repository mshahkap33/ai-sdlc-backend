# Database connection settings used by internal/config.LoadDatabaseConfig
# and consumed by cmd/migrate and any other backend service.
#
# These are local development defaults. Copy this file's values into a
# git-ignored .env.local (or export real environment variables) to override
# them for staging/production without committing secrets.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD='admin$123'
DB_NAME=ai_sdlc
DB_SSLMODE=disable

# REST API server settings used by internal/config.LoadServerConfig and
# consumed by cmd/server. JWT_SECRET must be overridden with a strong,
# private value outside of local development.
SERVER_ADDR=:8080
JWT_SECRET=local-development-only-change-me
